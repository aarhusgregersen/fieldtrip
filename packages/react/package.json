{
  "name": "@fieldtrip/react",
  "version": "0.1.0",
  "description": "Headless React bindings for @fieldtrip/core.",
  "type": "module",
  "license": "MIT",
  "author": "Martin Aarhus Gregersen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarhusgregersen/fieldtrip.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/aarhusgregersen/fieldtrip#readme",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fieldtrip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@fieldtrip/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": ">=18",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "forms",
    "wizard",
    "multi-step",
    "state-machine",
    "typescript",
    "standard-schema",
    "react",
    "hooks"
  ]
}
