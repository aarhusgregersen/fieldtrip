{
  "name": "@fieldtripjs/core",
  "version": "0.1.0",
  "description": "State machines for human input: typed, testable, analyzable multi-step flows.",
  "type": "module",
  "license": "MIT",
  "author": "Martin Aarhus Gregersen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarhusgregersen/fieldtrip.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aarhusgregersen/fieldtrip#readme",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fieldtripjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "forms",
    "wizard",
    "multi-step",
    "state-machine",
    "typescript",
    "standard-schema"
  ]
}
