{
  "name": "@fieldtripjs/core",
  "version": "0.2.1",
  "description": "State machines for human input: typed, testable, analyzable multi-step flows.",
  "type": "module",
  "license": "MIT",
  "author": "Martin Aarhus Gregersen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarhusgregersen/fieldtrip.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aarhusgregersen/fieldtrip#readme",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fieldtripjs/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "check:exports": "rm -rf .pack && pnpm pack --pack-destination .pack > /dev/null && attw .pack/*.tgz && publint run .pack/*.tgz && rm -rf .pack"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "keywords": [
    "forms",
    "wizard",
    "multi-step",
    "state-machine",
    "typescript",
    "standard-schema"
  ]
}
